/** Complete Hack computer: CPU + data memory + instruction ROM. */
CHIP Computer {
    IN reset;

    PARTS:
    ROM32K(address=pc, out=instruction);
    CPU(
        inM=memoryOut,
        instruction=instruction,
        reset=reset,
        outM=memoryIn,
        writeM=memoryLoad,
        addressM=memoryAddress,
        pc=pc
    );
    Memory(
        in=memoryIn,
        load=memoryLoad,
        address=memoryAddress,
        out=memoryOut
    );
}
