/**
 * Hack memory map:
 *   0      - 16383 : RAM16K
 *   16384  - 24575 : Screen
 *   24576           : Keyboard (read-only)
 *
 * RAM16K, Screen and Keyboard are standard built-in platform chips
 * supplied by the Nand2Tetris Hardware Simulator.
 */
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14]=0 selects RAM; address[14]=1 selects Screen/Keyboard.
    DMux(in=load, sel=address[14], a=loadRAM, b=loadScreenOrKeyboard);

    // Within the upper half, address[13]=0 selects Screen and 1 selects Keyboard.
    DMux(in=loadScreenOrKeyboard, sel=address[13],
         a=loadScreen, b=loadKeyboard);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    Mux16(a=screenOut, b=keyboardOut, sel=address[13], out=screenOrKeyboardOut);
    Mux16(a=ramOut, b=screenOrKeyboardOut, sel=address[14], out=out);
}
